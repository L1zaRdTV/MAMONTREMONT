@page
@model RequestsModel
@using MAMONT.Models
@{
    ViewData["Title"] = "Заявки";

    var activeRequests = Model.Requests
        .Where(request => RepairRequestStatus.Normalize(request.Status) == RepairRequestStatus.New)
        .ToList();
    var archivedRequests = Model.Requests
        .Where(request => RepairRequestStatus.Normalize(request.Status) == RepairRequestStatus.Processed)
        .ToList();
}

<section class="admin-section">
    <div class="admin-hero">
        <div class="section-heading">
            <p class="small-title">Админка</p>
            <h1>Заявки клиентов</h1>
            <p>Смотрите всю информацию из формы, звоните клиенту и нажимайте «Отработана», чтобы перенести заявку в архив.</p>
        </div>
        @if (Model.IsUnlocked)
        {
            <div class="admin-summary" aria-label="Статистика заявок">
                <div>
                    <span>Всего</span>
                    <strong>@Model.Requests.Count</strong>
                </div>
                <div>
                    <span>Новые</span>
                    <strong>@activeRequests.Count</strong>
                </div>
                <div>
                    <span>Архив</span>
                    <strong>@archivedRequests.Count</strong>
                </div>
                <div>
                    <span>Последняя</span>
                    <strong>@(Model.Requests.Count == 0 ? "—" : Model.Requests.Max(request => request.Id))</strong>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="admin-alert admin-alert-success" role="status">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="admin-alert admin-alert-error" role="alert">@Model.ErrorMessage</div>
    }

    @if (!Model.IsUnlocked)
    {
        <form method="post" class="admin-login-form">
            <div>
                <span class="login-eyebrow">Доступ к CRM</span>
                <h2>Введите пароль администратора</h2>
                <p>После входа откроется список заявок и кнопка переноса в архив.</p>
            </div>

            <label>
                Пароль
                <input asp-for="Password" type="password" maxlength="10" placeholder="Введите пароль" />
            </label>

            <button type="submit" class="main-button">Открыть заявки</button>
        </form>
    }
    else if (Model.Requests.Count == 0)
    {
        <div class="empty-state admin-empty">
            <strong>Пока заявок нет</strong>
            <span>Когда клиенты отправят форму с сайта, карточки появятся здесь.</span>
        </div>
    }
    else
    {
        <div class="request-groups">
            <section class="request-group" aria-labelledby="activeRequestsTitle">
                <div class="request-group-heading">
                    <div>
                        <p class="small-title">Новые заявки</p>
                        <h2 id="activeRequestsTitle">Нужно позвонить и уточнить детали</h2>
                    </div>
                    <span class="request-count">@activeRequests.Count</span>
                </div>

                @if (activeRequests.Count == 0)
                {
                    <div class="empty-state admin-empty compact-empty">
                        <strong>Новых заявок нет</strong>
                        <span>Все обращения уже перенесены в архив.</span>
                    </div>
                }
                else
                {
                    <div class="request-card-grid">
                        @foreach (var request in activeRequests)
                        {
                            @await Html.PartialAsync("_RequestCard", request)
                        }
                    </div>
                }
            </section>

            <details class="request-group archive-group" open>
                <summary class="request-group-heading" aria-labelledby="archiveRequestsTitle">
                    <span class="archive-toggle-icon" aria-hidden="true"></span>
                    <div>
                        <p class="small-title">Архив</p>
                        <h2 id="archiveRequestsTitle">Отработанные заявки</h2>
                    </div>
                    <span class="request-count">@archivedRequests.Count</span>
                </summary>

                <div class="archive-content">
                    @if (archivedRequests.Count == 0)
                    {
                        <div class="empty-state admin-empty compact-empty">
                            <strong>Архив пуст</strong>
                            <span>Нажмите «Отработана» после звонка клиенту, и заявка появится здесь.</span>
                        </div>
                    }
                    else
                    {
                        <div class="request-card-grid archive-card-grid">
                            @foreach (var request in archivedRequests)
                            {
                                @await Html.PartialAsync("_RequestCard", request)
                            }
                        </div>
                    }
                </div>
            </details>
        </div>
    }
</section>
