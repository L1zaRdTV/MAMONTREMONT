@page
@model RequestsModel
@using MAMONT.Models
@{
    ViewData["Title"] = "Заявки";

    var newCount = Model.Requests.Count(request => request.Status == RepairRequestStatus.New || string.IsNullOrWhiteSpace(request.Status));
    var acceptedCount = Model.Requests.Count(request => request.Status == RepairRequestStatus.Accepted);
    var cancelledCount = Model.Requests.Count(request => request.Status == RepairRequestStatus.Cancelled);
}

<section class="admin-section">
    <div class="admin-hero">
        <div class="section-heading">
            <p class="small-title">Админка</p>
            <h1>Заявки клиентов</h1>
            <p>Быстрый контроль входящих обращений: смотрите детали, принимайте заявки в работу или отменяйте неактуальные обращения.</p>
        </div>
        @if (Model.IsUnlocked)
        {
            <div class="admin-summary" aria-label="Статистика заявок">
                <div>
                    <span>Всего</span>
                    <strong>@Model.Requests.Count</strong>
                </div>
                <div>
                    <span>Новые</span>
                    <strong>@newCount</strong>
                </div>
                <div>
                    <span>Принятые</span>
                    <strong>@acceptedCount</strong>
                </div>
                <div>
                    <span>Отмененные</span>
                    <strong>@cancelledCount</strong>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="admin-alert admin-alert-success" role="status">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="admin-alert admin-alert-error" role="alert">@Model.ErrorMessage</div>
    }

    @if (!Model.IsUnlocked)
    {
        <form method="post" class="admin-login-form">
            <div>
                <span class="login-eyebrow">Доступ к CRM</span>
                <h2>Введите пароль администратора</h2>
                <p>После входа откроется список заявок и кнопки управления статусами.</p>
            </div>

            <label>
                Пароль
                <input asp-for="Password" type="password" maxlength="10" placeholder="Введите пароль" />
            </label>

            <button type="submit" class="main-button">Открыть заявки</button>
        </form>
    }
    else if (Model.Requests.Count == 0)
    {
        <div class="empty-state admin-empty">
            <strong>Пока заявок нет</strong>
            <span>Когда клиенты отправят форму с сайта, карточки появятся здесь.</span>
        </div>
    }
    else
    {
        <div class="request-card-grid">
            @foreach (var request in Model.Requests)
            {
                var status = RepairRequestStatus.IsValid(request.Status) ? request.Status : RepairRequestStatus.New;
                var statusLabel = RepairRequestStatus.GetLabel(status);
                var createdIso = request.CreatedAt.ToUniversalTime().ToString("O");
                var isAccepted = status == RepairRequestStatus.Accepted;
                var isCancelled = status == RepairRequestStatus.Cancelled;

                <article class="request-card request-card-@status">
                    <div class="request-card-top">
                        <div>
                            <span class="request-id">Заявка #@request.Id</span>
                            <h2>@request.Name</h2>
                            <time datetime="@createdIso">@request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                        </div>
                        <span class="status-badge status-badge-@status">@statusLabel</span>
                    </div>

                    <div class="request-contact-row">
                        <a href="tel:@request.Phone">@request.Phone</a>
                        @if (!string.IsNullOrWhiteSpace(request.Messenger))
                        {
                            <span>@request.Messenger</span>
                        }
                    </div>

                    <dl class="request-details">
                        <div>
                            <dt>Тип ремонта</dt>
                            <dd>@request.RepairType</dd>
                        </div>
                        <div>
                            <dt>Площадь</dt>
                            <dd>@request.Area м²</dd>
                        </div>
                        <div>
                            <dt>Расчет</dt>
                            <dd>@request.EstimatedPrice.ToString("N0") ₽</dd>
                        </div>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(request.Comment))
                    {
                        <div class="request-comment">
                            <span>Комментарий</span>
                            <p>@request.Comment</p>
                        </div>
                    }

                    <div class="request-actions" aria-label="Действия с заявкой #@request.Id">
                        <form method="post" asp-page-handler="UpdateStatus">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input type="hidden" name="status" value="@RepairRequestStatus.Accepted" />
                            <button type="submit" class="action-button accept-button" disabled="@isAccepted">Принять</button>
                        </form>
                        <form method="post" asp-page-handler="UpdateStatus">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input type="hidden" name="status" value="@RepairRequestStatus.Cancelled" />
                            <button type="submit" class="action-button cancel-button" disabled="@isCancelled">Отменить</button>
                        </form>
                        <form method="post" asp-page-handler="UpdateStatus">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input type="hidden" name="status" value="@RepairRequestStatus.New" />
                            <button type="submit" class="action-button neutral-button" disabled="@(status == RepairRequestStatus.New)">Вернуть в новые</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>
